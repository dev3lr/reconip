# recon-ip settings. Copy this file to .env and fill in what you want.
# .env is never committed to git. Leave a value empty to keep that feature off.

# Free key from https://www.abuseipdb.com/account/api  -> enables attack-report history
ABUSEIPDB_API_KEY=

# Key from https://console.anthropic.com  -> enables the Claude-written analyst assessment
ANTHROPIC_API_KEY=
# Max Claude-written reports per day (protects against a surprise bill)
AI_DAILY_LIMIT=200
